            lines {
              text: "4. **Search Flow**: Real-time offline search with category chip filters across technology titles, descriptions, capabilities, and tag keywords."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "5. **Compare Flow**: Select any two technologies from dropdown/search pickers and view a side-by-side grid comparing purpose, capabilities, pros, and trade-offs."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "6. **Bookmarks & History Flow**: View saved technologies and view timeline with search and clear options."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "7. **Settings Flow**: Toggle Light / Dark / System themes, reset view history, and view app metadata and version details."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Visual Identity & Theme"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Theme Vibe**: Modern AI Knowledge Base (Deep Indigo, Midnight Navy, Electric Violet, Cyber Blue, and Dark Slate)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Color Palette (M3 Semantic Tokens)**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - Primary: `#5C6BC0` (Indigo Blue) / `#8C9EFF` (Accent Violet)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - Secondary: `#26A69A` (Teal Cyber)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - Background Dark: `#0B0E17` (Deep Obsidian Midnight)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - Surface Dark: `#151B28` (Elevated Obsidian Slate)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - Surface Variant: `#1E2638`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Typography & Layout**: Standard Material 3 Typography scaled cleanly via `sp`. Card layouts with subtle borders (`1.dp` primary alpha outline), elevation layers, and touch targets ($ \\ge 48\\text{dp} $)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 3. Key Product Decisions & Trade-Offs"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Decision 1: Bundled Local Data Engine (JSON / Kotlin Data Store)**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Chosen Approach*: Static Kotlin/JSON dataset embedded directly in the APK with 100% complete descriptions for all 87 technologies and 11 categories."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Why*: Ensures 100% offline capability, zero latency, no API key setup, and instant search performance."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Decision 2: Room SQLite Persistence for User State**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Chosen Approach*: Room DB holding `BookmarkEntity` and `RecentViewEntity`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Why*: Clean reactive `Flow` integration with Jetpack Compose ViewModel state, type safety with KSP, and guaranteed persistence across app restarts."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Decision 3: Type-Safe Custom Navigation & Back Handling**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Chosen Approach*: ViewState-driven screen switching with `BackHandler` support for seamless tab and detail stack navigation."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Why*: Fast responsive screen transitions and reliable hardware/gesture back button handling."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
