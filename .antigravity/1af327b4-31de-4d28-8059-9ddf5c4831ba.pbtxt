edium,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant\n                )\n            }\n        }\n\n        item {\n            SearchBarComponent(\n                query = query,\n                onQueryChange = { query = it },\n                placeholder = \"Filter categories...\"\n            )\n        }\n\n        items(filteredCategories) { category ->\n            CategoryCard(\n                category = category,\n                onClick = { onCategoryClick(category.id) }\n            )\n        }\n    }\n}\n"
