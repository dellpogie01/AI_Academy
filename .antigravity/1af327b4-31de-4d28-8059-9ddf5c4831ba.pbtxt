  code_action {
    action_spec {
      create_file {
        instruction: "package com.example.ui.screens\n\nimport androidx.compose.foundation.layout.Box\nimport androidx.compose.foundation.layout.padding\nimport androidx.compose.material3.Scaffold\nimport androidx.compose.runtime.Composable\nimport androidx.compose.runtime.LaunchedEffect\nimport androidx.compose.runtime.getValue\nimport androidx.compose.ui.Modifier\nimport androidx.lifecycle.compose.collectAsStateWithLifecycle\nimport androidx.navigation.NavType\nimport androidx.navigation.compose.NavHost\nimport androidx.navigation.compose.composable\nimport androidx.navigation.compose.currentBackStackEntryAsState\nimport androidx.navigation.compose.rememberNavController\nimport androidx.navigation.navArgument\nimport com.example.ui.components.AppBottomNavigationBar\nimport com.example.ui.viewmodel.MainViewModel\nimport com.example.ui.viewmodel.NavTab\n\n@Composable\nfun MainScreen(\n    viewModel: MainViewModel\n) {\n    val state by viewModel.uiState.collectAsStateWithLifecycle()\n    val navController = rememberNavController()\n\n    val navBackStackEntry by navController.currentBackStackEntryAsState()\n    val currentRoute = navBackStackEntry?.destination?.route\n\n    // Show bottom bar on top-level tabs\n    val showBottomBar = currentRoute in listOf(\"home\", \"explore\", \"search\", \"bookmarks\", \"settings\")\n\n    val currentTab = when {\n        currentRoute?.startsWith(\"explore\") == true -> NavTab.EXPLORE\n        currentRoute?.startsWith(\"search\") == true -> NavTab.SEARCH\n        currentRoute?.startsWith(\"bookmarks\") == true -> NavTab.BOOKMARKS\n        currentRoute?.startsWith(\"settings\") == true -> NavTab.SETTINGS\n        else -> NavTab.HOME\n    }\n\n    Scaffold(\n        bottomBar = {\n            if (showBottomBar) {\n                AppBottomNavigationBar(\n                    currentTab = currentTab,\n                    onTabSelected = { tab ->\n                        val route = when (tab) {\n                            NavTab.HOME -> \"home\"\n                            NavTab.EXPLORE -> \"explore\"\n                            NavTab.SEARCH -> \"search\"\n                            NavTab.BOOKMARKS -> \"bookmarks\"\n                            NavTab.SETTINGS -> \"settings\"\n                        }\n                        navController.navigate(route) {\n                            popUpTo(navController.graph.startDestinationId) {\n                                saveState = true\n                            }\n                            launchSingleTop = true\n                            restoreState = true\n                        }\n                    }\n                )\n            }\n        }\n    ) { padding ->\n        Box(modifier = Modifier.padding(padding)) {\n            NavHost(\n                navController = navController,\n                startDestination = \"home\"\n            ) {\n                composable(\"home\") {\n                    HomeScreen(\n                        categories = state.categories,\n                        featuredTech = state.featuredTech,\n                        recentlyViewed = state.recentViewedTechs,\n                        bookmarkedIds = state.bookmarkedIds,\n                        onCategoryClick = { catId ->\n                            if (catId.isEmpty()) {\n                                navController.navigate(\"explore\")\n                            } else {\n                                navController.navigate(\"category_detail/$catId\")\n                            }\n                        },\n                        onTechnologyClick = { techId ->\n                            navController.navigate(\"tech_detail/$techId\")\n                        },\n                        onSearchClick = {\n                            navController.navigate(\"search\")\n                        },\n                        onBookmarkToggle = { techId ->\n                            viewModel.toggleBookmark(techId)\n                        },\n                        onCompareClick = {\n                            navController.navigate(\"compare\")\n                        }\n                    )\n                }\n\n                composable(\"explore\") {\n                    ExploreScreen(\n                        categories = state.categories,\n                        onCategoryClick = { catId ->\n                            navController.navigate(\"category_detail/$catId\")\n                        }\n                    )\n                }\n\n                composable(\"search\") {\n                    SearchScreen(\n                        query = state.searchQuery,\n                        onQueryChange = { viewModel.updateSearchQuery(it) },\n                        categories = state.categories,\n                        selectedCategoryFilter = state.selectedCategoryFilter,\n                        onCategoryFilterSelect = { viewModel.setCategoryFilter(it) },\n                        searchResults = state.searchResults,\n                        bookmarkedIds = state.bookmarkedIds,\n                        onBookmarkToggle = { viewModel.toggleBookmark(it) },\n                        onTechnologyClick = { techId ->\n                            navController.navigate(\"tech_detail/$techId\")\n                        }\n                    )\n                }\n\n                composable(\"bookmarks\") {\n                    BookmarksScreen(\n                        bookmarkedTechs = state.bookmarkedTechs,\n                        onBookmarkToggle = { viewModel.toggleBookmark(it) },\n                        onTechnologyClick = { techId ->\n                            navController.navigate(\"tech_detail/$techId\")\n                        },\n                        onClearBookmarks = { viewModel.clearBookmarks() },\n                        onExploreClick = {\n                            navController.navigate(\"explore\")\n                        }\n                    )\n                }\n\n                composable(\"settings\") {\n                    SettingsScreen(\n                        currentTheme = state.themeMode,\n                        onThemeSelect = { viewModel.setThemeMode(it) },\n                        onClearHistory = { viewModel.clearHistory() },\n                        onClearBookmarks = { viewModel.clearBookmarks() }\n                    )\n                }\n\n                composable(\n                    route = \"category_detail/{categoryId}\",\n                    arguments = listOf(navArgument(\"categoryId\") { type = NavType.StringType })\n                ) { backStackEntry ->\n                    val categoryId = backStackEntry.arguments?.getString(\"categoryId\") ?: \"\"\n                    val category = viewModel.getCategoryById(categoryId)\n                    if (category != null) {\n                        val techs = viewModel.getTechnologiesForCategory(categoryId)\n                        CategoryDetailScreen(\n                            category = category,\n                            technologies = techs,\n                            bookmarkedIds = state.bookmarkedIds,\n                            onBookmarkToggle = { viewModel.toggleBookmark(it) },\n                            onTechnologyClick = { techId ->\n                                navController.navigate(\"tech_detail/$techId\")\n                            },\n                            onBackClick = {\n                                navController.popBackStack()\n                            }\n                        )\n                    }\n                }\n\n                composable(\n                    route = \"tech_detail/{technologyId}\",\n                    arguments = listOf(navArgument(\"technologyId\") { type = NavType.StringType })\n                ) { backStackEntry ->\n                    val techId = backStackEntry.arguments?.getString(\"technologyId\") ?: \"\"\n                    LaunchedEffect(techId) {\n                        viewModel.openTechnology(techId)\n                    }\n                    val tech = viewModel.getTechnologyById(techId)\n                    if (tech != null) {\n                        val category = viewModel.getCategoryById(tech.categoryId)\n                        val related = tech.relatedTechIds.mapNotNull { viewModel.getTechnologyById(it) }\n\n                        TechnologyDetailScreen(\n                            technology = tech,\n                            categoryName = category?.name,\n                            relatedTechnologies = related,\n                            isBookmarked = state.bookmarkedIds.contains(tech.id),\n                            onBookmarkToggle = { viewModel.toggleBookmark(tech.id) },\n                            onTechnologyClick = { relatedId ->\n                                navController.navigate(\"tech_detail/$relatedId\")\n                            },\n                            onCompareClick = { compareId ->\n                                navController.navigate(\"compare?techId1=$compareId\")\n                            },\n                            onBackClick = {\n                                navController.popBackStack()\n                            }\n                        )\n                    }\n                }\n\n                composable(\n                    route = \"compare?techId1={techId1}&techId2={techId2}\",\n                    arguments = listOf(\n                        navArgument(\"techId1\") { type = NavType.StringType; nullable = true; defaultValue = null },\n                        navArgument(\"techId2\") { type = NavType.StringType; nullable = true; defaultValue = null }\n                    )\n                ) { backStackEntry ->\n                    val techId1 = backStackEntry.arguments?.getString(\"techId1\")\n                    val techId2 = backStackEntry.arguments?.getString(\"techId2\")\n\n                    CompareScreen(\n                        initialTechId1 = techId1,\n                        initialTechId2 = techId2,\n                        allTechnologies = state.searchResults.ifEmpty { viewModel.getTechnologiesForCategory(\"llm\") },\n                        onBackClick = {\n                            navController.popBackStack()\n                        }\n                    )\n                }\n            }\n        }\n    }\n}\n"
