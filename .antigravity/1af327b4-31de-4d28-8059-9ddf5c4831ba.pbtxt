            lines {
              text: "### Data Entities & Schema"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. **Category**: `id`, `name`, `shortDescription`, `fullPurpose`, `iconResName`, `colorHex`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **Technology**: `id`, `categoryId`, `name`, `overview`, `mainPurpose`, `keyFeatures: List<String>`, `commonUses: List<String>`, `advantages: List<String>`, `limitations: List<String>`, `relatedTechIds: List<String>`, `officialUrl: String`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. **BookmarkEntity (@Entity)**: `technologyId` (PrimaryKey), `timestamp`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "4. **RecentViewEntity (@Entity)**: `technologyId` (PrimaryKey), `timestamp`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
